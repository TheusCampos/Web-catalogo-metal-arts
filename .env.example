# ─────────────────────────────────────────────────────────────
# Chave pública — segura para ficar exposta no bundle do cliente
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="sua-url-do-supabase-aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"

# Também necessárias para o servidor (SSR / Server Functions)
SUPABASE_URL="sua-url-do-supabase-aqui"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"

# ─────────────────────────────────────────────────────────────
# Chave privada — NUNCA colocar VITE_ na frente!
# Usada apenas nas Server Functions de administrador (bypassa RLS).
# Obtenha em: Supabase Dashboard → Settings → API → service_role key
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"
